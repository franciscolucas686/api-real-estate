# Copie este arquivo para .env e preencha com valores reais.
# NUNCA commitar o .env real.
#
# .env.development e .env.test NÃO devem ser versionados (ver .gitignore).
# Eles são carregados pelo dotenv-cli através dos scripts do package.json
# (npm run start:dev / npm test), nunca pelo próprio código.

# postgresql://usuario:senha@host:5432/banco
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app_dev"

# development | production | test
NODE_ENV="development"

PORT=3000

# Origem permitida para CORS — UMA url só (é validada com z.url(); lista separada
# por vírgula não passa). Em dev o proxy do Vite mantém tudo na mesma origem, então
# este valor não é exercido; ele existe para o caso de o cliente furar o proxy.
CORS_ORIGIN="http://localhost:5173"

# Domínio dos cookies de sessão, COM ponto inicial (ex: .seudominio.com).
# DEIXE VAZIO — inclusive em produção, com o app no apex e a API em api.<dominio>.
# Quem emite o cookie é a API, então host-only já o prende ao host para onde as
# requisições vão, e `lax` não bloqueia porque é o mesmo *site*. Preencher só faria
# o cookie de sessão acompanhar apex, www e todo subdomínio futuro.
COOKIE_DOMAIN=""

# Mínimo de 32 caracteres. Gere com: openssl rand -base64 32
JWT_SECRET=""
JWT_REFRESH_SECRET=""

# Credenciais do bucket Cloudflare R2 (obrigatórias em produção)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_BASE_URL=""

# Opcional: endpoint S3-compatível alternativo (ex: MinIO local via docker-compose).
# Defina como http://localhost:9000 para usar MinIO em desenvolvimento.
# Deixe vazio para produção com Cloudflare R2 (endpoint gerado automaticamente).
R2_ENDPOINT=""

# Mínimo de 32 caracteres. Header x-admin-secret exigido em POST /api/auth/register
ADMIN_SECRET=""

# Habilita "npm run seed" manualmente. NUNCA usar em produção (apaga banco e R2).
RUN_SEED="true"
