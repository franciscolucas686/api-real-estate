# ─────────────────────────────────────────────────────────────────────────────
#  Setup local: copie este arquivo para .env.development
#
#      cp .env.example .env.development
#
#  ATENÇÃO ao nome do arquivo. Este projeto NÃO lê `.env`: todo script do
#  package.json carrega o arquivo explicitamente com o dotenv-cli
#  (`dotenv -e .env.development -- nest start`), nunca o código em si. E o
#  dotenv-cli IGNORA UM ARQUIVO AUSENTE EM SILÊNCIO, saindo com código 0 — então
#  criar `.env` por engano não dá erro nenhum de arquivo. O que acontece é o boot
#  morrer depois, na validação do Zod, com "JWT_SECRET deve ter no mínimo 32
#  caracteres": uma mensagem que aponta para a variável e nunca para a causa.
#
#  Os valores abaixo já são os que funcionam com o `docker compose up -d` deste
#  repositório (Postgres + MinIO). Copie e rode — não precisa preencher nada.
#  Para os testes, veja .env.test.example.
#
#  .env.development e .env.test NÃO são versionados (ver .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# development | production | test
NODE_ENV="development"

PORT=3000

# Postgres do docker-compose deste repositório.
# Formato: postgresql://usuario:senha@host:5432/banco
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app_dev"

# Origem permitida para CORS — UMA url só (é validada com z.url(); lista separada
# por vírgula não passa). Em dev o proxy do Vite mantém tudo na mesma origem, então
# este valor não é exercido; ele existe para o caso de o cliente furar o proxy.
CORS_ORIGIN="http://localhost:3000"

# Onde a SPA vive — destino do redirect das rotas de /share. Em dev precisa ser a
# porta do Vite, e não a do CORS_ORIGIN acima, que aponta para a própria API.
# Em produção pode ficar ausente: lá o CORS_ORIGIN já é esse endereço e serve de
# fallback.
APP_PUBLIC_URL="http://localhost:5173"

# Domínio dos cookies de sessão, COM ponto inicial (ex: .seudominio.com).
# DEIXE VAZIO — inclusive em produção, com o app no apex e a API em api.<dominio>.
# Quem emite o cookie é a API, então host-only já o prende ao host para onde as
# requisições vão, e `lax` não bloqueia porque é o mesmo *site*. Preencher só faria
# o cookie de sessão acompanhar apex, www e todo subdomínio futuro.
COOKIE_DOMAIN=""

# ─── Segredos ────────────────────────────────────────────────────────────────
# Mínimo de 32 caracteres cada (exigência do Zod em src/config/env.config.ts).
# Os valores abaixo são dummies de DESENVOLVIMENTO, propositalmente óbvios.
# Em produção, gere os reais com: openssl rand -base64 32
JWT_SECRET="dev-jwt-secret-must-be-at-least-32-chars!"
JWT_REFRESH_SECRET="dev-refresh-secret-must-be-at-least-32!!"

# Header x-admin-secret exigido em POST /api/auth/register.
ADMIN_SECRET="dev-admin-secret-must-be-at-least-32-ch!"

# ─── Armazenamento de imagens ────────────────────────────────────────────────
# Em produção é o Cloudflare R2; em desenvolvimento é o MinIO do docker-compose,
# que fala o mesmo protocolo S3. Os valores abaixo batem exatamente com o serviço
# `minio` do docker-compose.yml, inclusive o bucket que o `minio-setup` cria.
#
# Preencher isto NÃO é opcional em dev: `npm run db:seed:dev` limpa o bucket e faz
# upload das fotos de exemplo, então falha sem estas variáveis.
#
# Para apontar de volta ao Cloudflare R2, deixe R2_ENDPOINT vazio (o endpoint é
# derivado do R2_ACCOUNT_ID) e troque as credenciais pelas do bucket real.
R2_ENDPOINT="http://localhost:9000"
R2_ACCESS_KEY_ID="minioadmin"
R2_SECRET_ACCESS_KEY="minioadmin"
R2_BUCKET_NAME="real-estate-dev"
R2_PUBLIC_BASE_URL="http://localhost:9000/real-estate-dev"
R2_ACCOUNT_ID="local"

# ─── Seed ────────────────────────────────────────────────────────────────────
# Habilita "npm run db:seed:dev". O seed APAGA o banco e o bucket inteiros antes de
# recriar os dados — por isso ele exige este opt-in explícito e se recusa a rodar
# com NODE_ENV=production.
RUN_SEED="true"
